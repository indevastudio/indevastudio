{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/interior-designer-delhi",
      "destination": "/delhi",
      "permanent": true
    },
    {
      "source": "/interior-designer-gurgaon",
      "destination": "/gurgaon",
      "permanent": true
    },
    {
      "source": "/insights/affordable-luxury-interior-design-delhi-ncr-case-study-case-study",
      "destination": "/insights/affordable-luxury-interior-design-delhi-ncr",
      "permanent": true
    },
    {
      "source": "/insights/bedroom-false-ceiling-design-ideas-india-step-by-step-by-step",
      "destination": "/insights/bedroom-false-ceiling-design-ideas",
      "permanent": true
    },
    {
      "source": "/insights/bespoke-villa-interior-design-noida-mistakes-mistakes-to",
      "destination": "/insights/bespoke-villa-interior-design-noida",
      "permanent": true
    },
    {
      "source": "/insights/farmhouse-villa-interior-design-gurgaon-mistakes-mistakes-to",
      "destination": "/insights/farmhouse-villa-interior-design-gurgaon",
      "permanent": true
    },
    {
      "source": "/insights/luxury-bedroom-design-cost-delhi-ncr-case-study-case-study",
      "destination": "/insights/luxury-bedroom-design-cost-delhi-ncr",
      "permanent": true
    },
    {
      "source": "/insights/luxury-interior-design-company-noida-mistakes-mistakes-to",
      "destination": "/insights/luxury-interior-design-company-noida",
      "permanent": true
    },
    {
      "source": "/insights/luxury-living-room-interior-design-delhi-cost-guide-cost-guide",
      "destination": "/insights/luxury-living-room-interior-design-delhi",
      "permanent": true
    },
    {
      "source": "/insights/luxury-villa-bedroom-design-ideas-india-design-ideas-design-ideas",
      "destination": "/insights/luxury-villa-bedroom-design-ideas",
      "permanent": true
    },
    {
      "source": "/insights/premium-restaurant-design-ideas-design-ideas",
      "destination": "/insights/premium-restaurant-design-ideas",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/process", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/philosophy", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/insights/:slug*", "destination": "/index.html" },
    { "source": "/vendors", "destination": "/index.html" },
    { "source": "/furniture", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|ico|woff2?|ttf|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
