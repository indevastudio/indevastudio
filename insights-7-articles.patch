index c78ef05..c3006cf 100644
--- a/scripts/sitemap.js
+++ b/scripts/sitemap.js
@@ -37,13 +37,26 @@ const urlTag = ({ loc, priority, changefreq }) => `
     <priority>${priority}</priority>
   </url>`;
 
-// Read only ACTUAL HTML files from insights/ — prevents dead sitemap entries
-const blogSlugs = fs.existsSync(INSIGHTS)
+// Read ACTUAL published posts from insights/ — both formats:
+//  1. Flat files:   insights/<slug>.html            (current generator output)
+//  2. Folder posts: insights/<slug>/index.html       (legacy format, ~330 existing posts)
+// Scanning only flat files silently drops legacy posts from the sitemap — this
+// caught 326 missing URLs (345 → 19) when it only checked format 1. Both are
+// live, indexable URLs and must both be included.
+const flatSlugs = fs.existsSync(INSIGHTS)
   ? fs.readdirSync(INSIGHTS)
       .filter(f => f.endsWith('.html') && f !== 'index.html')
       .map(f => f.replace('.html',''))
   : [];
 
+const folderSlugs = fs.existsSync(INSIGHTS)
+  ? fs.readdirSync(INSIGHTS, { withFileTypes: true })
+      .filter(d => d.isDirectory() && fs.existsSync(path.join(INSIGHTS, d.name, 'index.html')))
+      .map(d => d.name)
+  : [];
+
+const blogSlugs = [...new Set([...flatSlugs, ...folderSlugs])].sort();
+
 const blogUrls = blogSlugs.map(slug =>
   urlTag({ loc:`/insights/${slug}`, priority:'0.6', changefreq:'monthly' })
